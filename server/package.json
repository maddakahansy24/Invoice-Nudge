{
  "name": "invoice-nudge-server",
  "version": "1.0.0",
  "description": "Invoice Nudge Express Backend & REST API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
