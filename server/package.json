    "build-client": "cd ../client && npm install && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.9.5"
  }
}
